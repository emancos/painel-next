# ========================================================================
# VARIÁVEIS DE AMBIENTE DA VPS (/opt/painel-next/.env)
# ========================================================================

# 1. Repositório GitHub (usado pelo docker compose para puxar a imagem do GHCR)
# Exemplo: GITHUB_REPOSITORY=seu-usuario-github/painel-next
GITHUB_REPOSITORY=emancos/painel-de-chamados

# 2. Banco de Dados PostgreSQL Interno do Container
POSTGRES_USER=painel_next
POSTGRES_PASSWORD=defina_uma_senha_forte_do_postgres_aqui
POSTGRES_DB=painel_next

# String de Conexão com o container postgres (porta interna 5432 na rede interna do docker)
DATABASE_URL=postgresql://painel_next:defina_uma_senha_forte_do_postgres_aqui@postgres:5432/painel_next

# 3. Redis Interno do Container (Pub/Sub de Chamadas e Filas)
REDIS_URL=redis://redis:6379

# 4. Domínio Público (Cloudflare + NPM)
NEXT_PUBLIC_APP_URL=https://painel-next.integrasistemas.tec.br

# 5. Segurança e Criptografia de Sessões (JWT)
# Dica: gere uma chave segura com o comando: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_painel_next_production_key_2026

# 6. Credenciais do Primeiro Administrador (utilizado para o Seed Inicial)
EMAIL_ADDRESS=admin@integrasistemas.tec.br
ADMIN_PASSWORD=DefinaSuaSenhaSeguraAdmin@2026

# 7. Ambiente
NODE_ENV=production
